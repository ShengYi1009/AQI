<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Cursor="">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="500*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="600*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Background="AliceBlue" Height="80">
            <Label Content="空氣品質監測資料網址" HorizontalAlignment="Left" Margin="50,20,0,20" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="URLTextBox" VerticalContentAlignment="Center" Margin="20,10,20,10" Width="1200" Height="30" Text="AQI資料網址" FontSize="14"/>
            <Button x:Name="GetAqiButton" VerticalAlignment="Center" Width="100" Height="30" Content="取得AQI資料" FontSize="16" Click="GetAqiButton_Click" />
        </StackPanel>
        <TextBox x:Name="ContentTextBox" Grid.Row="1" Grid.Column="0" Background="#FFFBF8EA" FontSize="14" Padding="5" Margin="5"/>
        <GridSplitter Grid.Row="1" Grid.Column="1" Height="Auto" Width="5" Background="LightGray" HorizontalAlignment="Stretch" />
        <Border Grid.Row="1" Grid.Column="2" Margin="2" BorderBrush="Red" BorderThickness="1" Background="#FFFBF4F4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition />
                </Grid.RowDefinitions>
                <DataGrid x:Name="RecordDataGrid" AutoGenerateColumns="True" />
                <GridSplitter Grid.Row="1" Background="LightGray" Height="5" HorizontalAlignment="Stretch" />
                <Border  Grid.Row="2" BorderBrush="Green" BorderThickness="1" Margin="2">
                    <WrapPanel x:Name="DataWrapPanel" Orientation="Horizontal" Margin="5" Height="100" Background="#FFDFF7D5"/>
                </Border>

                <lvc:CartesianChart x:Name="AQIChart" Grid.Row="3" MinWidth="500" Height="400">

                </lvc:CartesianChart>
            </Grid>
        </Border>
        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="LightGray" Height="30">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="14" Margin="100,0,0,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
